# i686-sagui.cross - modelo FUTURO de cross-file para um porte upstream.
# A camada atual userland/mlibc e uma shim C no build Make/GCC; este arquivo
# sozinho nao compila nem configura o mlibc oficial (faltam toolchain/sysroot).
# Ver docs/mlibc.md antes de usar como base para um porte Meson.
[host_machine]
system = 'sagui'
cpu_family = 'x86'
cpu = 'i686'
endian = 'little'
[binaries]
c = 'i686-sagui-gcc'
cpp = 'i686-sagui-g++'
ar = 'i686-sagui-ar'
strip = 'i686-sagui-strip'
ld = 'i686-sagui-ld'
[built-in options]
c_args = ['-m32', '-march=i686', '-ffreestanding', '-nostdlib', '-fno-pic', '-fno-pie', '-mgeneral-regs-only']
cpp_args = ['-m32', '-march=i686', '-ffreestanding', '-nostdlib', '-fno-pic', '-fno-pie', '-mgeneral-regs-only']
